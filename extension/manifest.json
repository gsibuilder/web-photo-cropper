{
  "manifest_version": 3,
  "name": "Edge Photo Clicker to Qt Cropper",
  "version": "1.0",
  "author": "Corey Kiesel",
  "description": "Automatically catches image clicks in Microsoft Edge and sends them to the Qt6 Cropper & Saver desktop app by Corey Kiesel.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:59999/*",
    "http://localhost:59999/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Qt6 Photo Cropper Watcher"
  }
}
